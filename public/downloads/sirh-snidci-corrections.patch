--- /dev/null
+++ b/lib/storage-path.ts
@@ -0,0 +1,21 @@
+/**
+ * Supabase Storage refuse les clés contenant des accents ou certains caractères
+ * spéciaux ("Invalid key"). Un fichier "Diplôme d'ingénieur.pdf" faisait donc
+ * échouer l'envoi. On normalise le nom avant de construire le chemin.
+ */
+export function safeStorageName(fileName: string): string {
+  const dot = fileName.lastIndexOf(".");
+  const base = dot > 0 ? fileName.slice(0, dot) : fileName;
+  const ext = dot > 0 ? fileName.slice(dot + 1) : "";
+  const clean = (s: string) =>
+    s
+      .normalize("NFD")
+      .replace(/[\u0300-\u036f]/g, "") // retire les accents
+      .replace(/[^a-zA-Z0-9-_]+/g, "-") // remplace le reste par "-"
+      .replace(/-+/g, "-")
+      .replace(/^-|-$/g, "")
+      .toLowerCase();
+  const b = clean(base).slice(0, 80) || "fichier";
+  const e = clean(ext).slice(0, 10);
+  return e ? `${b}.${e}` : b;
+}
