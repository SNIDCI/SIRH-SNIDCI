@@ -0,0 +1,26 @@
+import { redirect } from "next/navigation";
+import { createClient } from "@/lib/supabase/server";
+import type { AppRole } from "@/lib/types";
+
+/**
+ * Garde serveur : redirige vers le tableau de bord si l'utilisateur connecté
+ * n'a pas l'un des rôles demandés. La RLS protège déjà les données, mais sans
+ * cette garde un employé pouvait ouvrir /admin ou /payroll et voir des écrans
+ * vides ou des formulaires qui échouent silencieusement.
+ */
+export async function requireRole(roles: AppRole[]) {
+  const supabase = createClient();
+  const { data: { user } } = await supabase.auth.getUser();
+  if (!user) redirect("/login");
+
+  const { data: profile } = await supabase
+    .from("profiles")
+    .select("role")
+    .eq("id", user.id)
+    .single();
+
+  if (!profile || !roles.includes(profile.role as AppRole)) {
+    redirect("/dashboard?acces=refuse");
+  }
+  return { user, role: profile.role as AppRole };
+}
